{
  "manifestVersion": 1,
  "key": "helpdesk",
  "name": "Support Desk",
  "version": "1.0.0",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.helpdesk.desc",
    "fallback": "A customer help desk with a searchable knowledge base, ticket threads, and an agent queue — backed by your own database."
  },
  "categories": [
    "crm"
  ],
  "compatibility": {
    "minAdminiumVersion": "1.0.0",
    "engines": [
      "postgres",
      "mysql",
      "sqlite"
    ],
    "requires": [
      "realtime"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "agents",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "full_name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "avatar_url",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "active",
            "type": "bool"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "customers",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "address",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "products",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "code",
            "type": "text"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "model",
            "type": "text"
          },
          {
            "ref": "icon",
            "type": "text"
          },
          {
            "ref": "tint",
            "type": "text"
          }
        ]
      },
      {
        "ref": "kb_categories",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "slug",
            "type": "text"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "icon",
            "type": "text"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "blurb",
            "type": "text"
          },
          {
            "ref": "position",
            "type": "int"
          }
        ]
      },
      {
        "ref": "kb_articles",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "slug",
            "type": "text"
          },
          {
            "ref": "category_id",
            "type": "fk",
            "references": "kb_categories"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "snippet",
            "type": "text"
          },
          {
            "ref": "read_minutes",
            "type": "int"
          },
          {
            "ref": "body",
            "type": "json"
          },
          {
            "ref": "published",
            "type": "bool"
          },
          {
            "ref": "position",
            "type": "int"
          },
          {
            "ref": "updated_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "tickets",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "requester_name",
            "type": "text"
          },
          {
            "ref": "requester_email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "customer_id",
            "type": "fk",
            "references": "customers"
          },
          {
            "ref": "product_id",
            "type": "fk",
            "references": "products"
          },
          {
            "ref": "topic",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]",
              "[object Object]",
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "subject",
            "type": "text"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]",
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "priority",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]",
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "assignee_id",
            "type": "fk",
            "references": "agents"
          },
          {
            "ref": "first_response_minutes",
            "type": "int"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          },
          {
            "ref": "updated_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "ticket_messages",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "ticket_id",
            "type": "fk",
            "references": "tickets"
          },
          {
            "ref": "author",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "agent_id",
            "type": "fk",
            "references": "agents"
          },
          {
            "ref": "body",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "orders",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "customer_id",
            "type": "fk",
            "references": "customers"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]",
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "carrier",
            "type": "text"
          },
          {
            "ref": "tracking_code",
            "type": "text"
          },
          {
            "ref": "total",
            "type": "money"
          },
          {
            "ref": "placed_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "order_items",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "order_id",
            "type": "fk",
            "references": "orders"
          },
          {
            "ref": "product_id",
            "type": "fk",
            "references": "products"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "qty",
            "type": "int"
          },
          {
            "ref": "unit_price",
            "type": "money"
          }
        ]
      },
      {
        "ref": "order_events",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "order_id",
            "type": "fk",
            "references": "orders"
          },
          {
            "ref": "label",
            "type": "text"
          },
          {
            "ref": "detail",
            "type": "text"
          },
          {
            "ref": "state",
            "type": "enum",
            "enum": [
              "[object Object]",
              "[object Object]",
              "[object Object]"
            ]
          },
          {
            "ref": "position",
            "type": "int"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "helpdesk-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.helpdesk.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:helpdesk",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "helpdesk-queue",
      "template": "page-master-detail",
      "title": {
        "key": "mft.helpdesk.page.queue",
        "fallback": "Ticket queue"
      },
      "nav": {
        "group": "manifest:helpdesk",
        "icon": "inbox",
        "order": 2
      }
    },
    {
      "ref": "helpdesk-kb",
      "template": "page-crud",
      "title": {
        "key": "mft.helpdesk.page.kb",
        "fallback": "Knowledge base"
      },
      "nav": {
        "group": "manifest:helpdesk",
        "icon": "book-open",
        "order": 3
      }
    },
    {
      "ref": "helpdesk-agents",
      "template": "page-directory",
      "title": {
        "key": "mft.helpdesk.page.agents",
        "fallback": "Agents"
      },
      "nav": {
        "group": "manifest:helpdesk",
        "icon": "users",
        "order": 4
      }
    }
  ],
  "capabilities": [
    "file-storage",
    "email-delivery",
    "realtime"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "customer",
      "kind": "spa",
      "entry": "index.html",
      "routes": {
        "portal": "/"
      }
    }
  ]
}
